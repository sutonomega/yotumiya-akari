{
  "name": "yorumiya-ai",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node bot.js",
    "start:x": "node -e \"process.env.BOT_TARGET='x'; require('./bot')\"",
    "start:discord": "node -e \"process.env.BOT_TARGET='discord'; require('./bot')\"",
    "test:time-post": "TEST_TIME_POST_HOUR=21 node scripts/test-time-post.js",
    "test": "npm run test:unit && npm run test:time-post",
    "test:unit": "node --test test/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/**/*.test.js",
    "web": "concurrently -k -n server,frontend \"npm run web:server\" \"npm run web:frontend\"",
    "web:server": "node webChatServer.js",
    "web:frontend": "npm run dev --prefix frontend -- --host 127.0.0.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "twitter-api-v2": "^1.29.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3"
  }
}
